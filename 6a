import { useState } from 'react';

function Student(props) {
  const [marks, setMarks] = useState(80);

  return (
    <div>
      <h2>Name: {props.name}</h2>
      <p>Marks: {marks}</p>
      <button onClick={() => setMarks(marks + 5)}>
        Add Marks
      </button>
    </div>
  );
}

function App() {
  return <Student name="Navya" />;
}

export default App;
