app.js


const express = require('express');
const app = express();

app.set('view engine', 'ejs');

app.get('/', (req, res) => {
    res.render('home', {
        name: 'Navya',
        course: 'CSE',
        college: 'Vishnu Institute of Technology'
    });
});

app.listen(3000, () => console.log('Server running'));

